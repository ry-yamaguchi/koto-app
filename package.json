{
  "name": "koto",
  "version": "0.3.2",
  "description": "AIと対話してアプリを作り、公開できるmacOS向けIDE",
  "main": "dist/main/main.js",
  "license": "Apache-2.0",
  "private": true,
  "author": "meryo",
  "scripts": {
    "gen:licenses": "node scripts/gen-licenses.mjs",
    "fetch:crane": "node scripts/fetch-crane.mjs",
    "dev": "concurrently \"npm run dev:renderer\" \"npm run dev:main\"",
    "dev:renderer": "vite",
    "dev:main": "tsc -p tsconfig.main.json --watch",
    "build": "npm run build:renderer && npm run build:main",
    "build:renderer": "tsc --noEmit -p tsconfig.json && vite build",
    "build:main": "tsc -p tsconfig.main.json",
    "electron": "NODE_ENV=development electron .",
    "start": "npm run fetch:crane && npm run build:main && concurrently -n renderer,electron -c magenta,green \"npm run dev:renderer\" \"wait-on http://localhost:5173 && NODE_ENV=development electron .\"",
    "dist": "npm run check:build && npm run fetch:crane && npm run gen:licenses && npm run build && electron-builder --mac --config electron-builder.config.js && node scripts/dmg-notarize.mjs --auto",
    "smoke": "node scripts/smoke-test.mjs",
    "check:models": "node scripts/check-models.mjs",
    "check:links": "node scripts/check-links.mjs",
    "probe:models": "node scripts/probe-models.mjs",
    "release": "npm version patch --no-git-tag-version && npm run dist && npm run smoke",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:build": "node scripts/check-build-config.mjs"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.220",
    "@monaco-editor/react": "^4.6.0",
    "electron-updater": "^6.8.9",
    "monaco-editor": "^0.52.0",
    "node-pty": "^1.0.0",
    "openai": "^4.100.0",
    "react-resizable-panels": "^4.11.2",
    "xterm": "^5.3.0",
    "xterm-addon-fit": "^0.8.0",
    "xterm-addon-web-links": "^0.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.4",
    "@types/node": "^20.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.0",
    "concurrently": "^9.0.0",
    "electron": "^33.0.0",
    "electron-builder": "^26.15.2",
    "license-checker-rseidelsohn": "^5.0.1",
    "postcss": "^8.4.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vite-plugin-electron": "^0.28.0",
    "vitest": "^4.1.9",
    "wait-on": "^9.0.10"
  },
  "build": {
    "appId": "io.github.meryo.koto",
    "productName": "Koto",
    "copyright": "© 2026 meryo",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "docs/usage-guide.html",
      "docs/third-party-licenses.html",
      "build/icon.png",
      "package.json",
      "LICENSE",
      "NOTICE",
      "!node_modules/monaco-editor/**",
      "!node_modules/@monaco-editor/**"
    ],
    "asarUnpack": [
      "**/node_modules/node-pty/**",
      "**/node_modules/@anthropic-ai/**"
    ],
    "extraResources": [
      {
        "from": "node_modules/electron/dist/LICENSE",
        "to": "licenses/electron-LICENSE.txt"
      },
      {
        "from": "node_modules/electron/dist/LICENSES.chromium.html",
        "to": "licenses/LICENSES.chromium.html"
      },
      {
        "from": "build/bin/crane",
        "to": "bin/crane"
      }
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.icns",
      "category": "public.app-category.developer-tools",
      "identity": null
    },
    "publish": [
      {
        "provider": "github",
        "owner": "ry-yamaguchi",
        "repo": "koto-app"
      }
    ]
  }
}
